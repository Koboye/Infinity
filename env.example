# Gebeya Link v1 runs local-first and needs no keys at all.
# Data is stored on the phone (works fully offline) unless you connect
# a shop code from Settings → Company Sync, which needs the backend below.

# ── v2: company backend (Supabase) ──────────────────────────────────
# Create a project at https://supabase.com, run supabase/schema.sql in
# its SQL editor, then fill these in from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── v2: billing (Stripe) — optional, only needed for paid plans ─────
# From https://dashboard.stripe.com/apikeys and /webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_ID=

# Used to build absolute redirect URLs for Checkout/portal when the
# request's Origin header isn't reliable (e.g. some webhook contexts).
NEXT_PUBLIC_APP_URL=
