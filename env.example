# Firebase client (public) — Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only) — Project settings → Service accounts → Generate key.
# Either one JSON blob...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or the three separate values:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: hard global rate limit across all server instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ads (optional). Owner page /admin/ads and its API are OFF unless this is set. Use a long random value (16+ characters).
ADS_ADMIN_KEY=
# Extra hosts ad pictures may load from (space separated, e.g. https://cdn.mybank.example). Firebase Storage is always allowed.
NEXT_PUBLIC_ADS_IMG_HOSTS=
