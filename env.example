# Firebase client (public) — Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only) — Project settings → Service accounts → Generate key.
# Either one JSON blob...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or the three separate values:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: hard global rate limit across all server instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ads (optional). Owner page /admin/ads and its API are OFF unless this is set. Use a long random value (16+ characters).
ADS_ADMIN_KEY=
# Extra hosts ad pictures may load from (space separated, e.g. https://cdn.mybank.example). Firebase Storage is always allowed.
NEXT_PUBLIC_ADS_IMG_HOSTS=

# Number of trusted reverse proxies in front of the app (default 1). Used to read the real client IP
# for the ad-admin lockout and rate limits. On Vercel the platform header is used automatically.
TRUST_PROXY_HOPS=

# Daily level pass (optional, OFF by default = every level is free).
# PAYWALL=1 on the server and NEXT_PUBLIC_PAYWALL=1 in the build turn it on: 10 computer-game starts per Ethiopian day after one payment.
PAYWALL=
NEXT_PUBLIC_PAYWALL=
# The code the player dials to pay (a tel: link opens the dialer; the player must press call).
NEXT_PUBLIC_PAY_USSD=*806*0928390022*1#
# Secret (24+ random characters) for /api/pay/confirm: your payment provider's webhook, an SMS forwarder or you by hand. Disabled when unset.
PAY_WEBHOOK_SECRET=
# Smallest payment amount (in birr) the SMS auto-approval accepts. Unset = any amount.
NEXT_PUBLIC_PASS_PRICE=
# Set this to the price of one pass. Without it, any SMS that names a player's number can open a pass.
PASS_MIN_AMOUNT=

# Signs the Hill Climb ticket cookie (24+ random characters). Optional: falls back to PAY_WEBHOOK_SECRET.
PASS_TICKET_SECRET=

# Address of the deployed ExamPrep app (apps/exam-prep). The home-screen ExamPrep card opens it; without it the card shows "Coming soon".
NEXT_PUBLIC_EXAMPREP_URL=
