rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profiles. Anyone signed in can read (leaderboard). A player may create their
    // own profile with starting stats and edit only cosmetic fields. Rating / wins / losses /
    // draws are written by the server (Admin SDK) after a match, never by the client.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.rating == 1000
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.draws == 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatar', 'lang', 'progress', 'photo'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 30000 && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,.*'))))
        && (!('progress' in request.resource.data) || (request.resource.data.progress is string && request.resource.data.progress.size() < 6000))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20;
      allow delete: if false;
    }

    // Coin wallets. A player can read only their own; every change (gift, spins, fees, prizes) is made by the server.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Ads: the ads themselves, their counters and the rewarded-ad sessions are read and written only by the server
    // (/api/ads, /api/admin/ads, /api/gebeta). Phones get ads through the API, never from Firestore directly.
    match /ads/{id} { allow read, write: if false; }
    match /adStats/{id} { allow read, write: if false; }
    match /adSessions/{uid} { allow read, write: if false; }

    // Online matches (Gebeta, Checkers, Dominoes). Only the two players can read the room they are in.
    // ALL writes go through /api/gebeta (server validates every move with the shared engines).
    match /gebetaRooms/{code} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow write: if false;

      // Hidden information (dominoes hands). Document id = the owner's uid, so you can only read your own hand.
      // The boneyard document (_boneyard) matches no uid and is therefore server-only.
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == docId;
        allow write: if false;
      }
    }
  }
}
