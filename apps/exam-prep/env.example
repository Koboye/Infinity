# Firebase client (public): Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin (server only): Project settings → Service accounts → Generate key. One JSON blob...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or the three separate values:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Owner secret (24+ random characters): opens /admin to review questions and confirm payments. Disabled when unset.
ADMIN_SECRET=
# Optional second secret (24+ random characters) for a payment provider or SMS forwarder. It can only confirm payments.
WEBHOOK_SECRET=
# What the student sees when paying. The USSD code opens the dialer through a tel: link; the student presses call themselves.
NEXT_PUBLIC_PAY_USSD=
NEXT_PUBLIC_PAY_NOTE=
